@model AcxiomCRM.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Provision New User";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back to User List
            </a>
            <h3 class="fw-bold mb-0">Provision New Staff User</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold text-primary"><i class="bi bi-person-badge me-2"></i>User Profile & Role Definition</h6>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-muted text-uppercase">Full Name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Jason Brooks" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted text-uppercase">Email Address *</label>
                            <input asp-for="Email" class="form-control" placeholder="jason@acxiom.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label small fw-semibold text-muted text-uppercase">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Inbound Sales" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label small fw-semibold text-muted text-uppercase">Role Assignment *</label>
                            <select asp-for="Role" class="form-select">
                                <option value="SalesExecutive">Sales Executive</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Administrator</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-muted text-uppercase">Initial Password *</label>
                            <input asp-for="Password" class="form-control" placeholder="Min. 8 chars with complexity" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted text-uppercase">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-type password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-person-check-fill me-1"></i> Provision Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
