@model IEnumerable<AcxiomCRM.Controllers.UserManagementController.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-gear text-danger me-2"></i>User & Role Administration</h2>
        <p class="text-muted small mb-0">Manage staff identity profiles, role-based authorization, and account lockouts</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Provision New User
    </a>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small fw-bold text-muted">
                <tr>
                    <th>User</th>
                    <th>Email Address</th>
                    <th>Department</th>
                    <th>Assigned Role</th>
                    <th>Account Status</th>
                    <th>Security / Lockout</th>
                    <th>Created</th>
                    <th class="text-end">Administration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 34px; height: 34px; font-size: 0.8rem;">
                                    @user.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <span class="fw-semibold">@user.FullName</span>
                            </div>
                        </td>
                        <td>
                            <span class="small font-monospace">@user.Email</span>
                        </td>
                        <td>@(user.Department ?? "—")</td>
                        <td>
                            @{
                                string roleBadge = user.Role switch
                                {
                                    "Admin" => "bg-danger text-white",
                                    "Manager" => "bg-primary text-white",
                                    "SalesExecutive" => "bg-success text-white",
                                    _ => "bg-secondary text-white"
                                };
                            }
                            <span class="badge @roleBadge px-2 py-1">@user.Role</span>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger text-white">
                                    <i class="bi bi-lock-fill me-1"></i> Locked Out
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Normal</span>
                            }
                        </td>
                        <td>
                            <span class="small text-muted">@user.CreatedDate.ToString("yyyy-MM-dd")</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <!-- Change Role Button -->
                                <button type="button" class="btn btn-outline-secondary" title="Change Role" data-bs-toggle="modal" data-bs-target="#roleModal-@user.Id">
                                    <i class="bi bi-person-badge"></i>
                                </button>

                                <!-- Reset Password Button -->
                                <button type="button" class="btn btn-outline-warning" title="Reset Password" data-bs-toggle="modal" data-bs-target="#pwdModal-@user.Id">
                                    <i class="bi bi-key"></i>
                                </button>

                                <!-- Unlock Button (if locked) -->
                                @if (user.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning" title="Unlock User">
                                            <i class="bi bi-unlock-fill"></i> Unlock
                                        </button>
                                    </form>
                                }

                                <!-- Toggle Active Status -->
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Role Modal -->
                            <div class="modal fade" id="roleModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content text-start">
                                        <div class="modal-header">
                                            <h5 class="modal-title"><i class="bi bi-shield-check me-2 text-primary"></i>Assign Role for @user.FullName</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="ChangeRole" asp-route-id="@user.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body">
                                                <label class="form-label small fw-semibold text-muted text-uppercase">Select Primary Role</label>
                                                <select name="newRole" class="form-select">
                                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin (Full Control)</option>
                                                    <option value="Manager" selected="@(user.Role == "Manager")">Manager (Team & Pipeline View)</option>
                                                    <option value="SalesExecutive" selected="@(user.Role == "SalesExecutive")">Sales Executive (Assigned Records Only)</option>
                                                </select>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Update Role</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Password Reset Modal -->
                            <div class="modal fade" id="pwdModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content text-start">
                                        <div class="modal-header">
                                            <h5 class="modal-title"><i class="bi bi-key-fill me-2 text-warning"></i>Reset Password for @user.Email</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body">
                                                <label class="form-label small fw-semibold text-muted text-uppercase">New Password *</label>
                                                <input type="password" name="newPassword" class="form-control" required placeholder="Min 8 chars with uppercase, number, symbol" />
                                                <div class="form-text small">Must adhere to the system password complexity requirements.</div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-warning">Reset Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
