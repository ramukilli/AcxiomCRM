@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Security Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-shaded text-primary me-2"></i>Security & Operations Audit Trail</h2>
        <p class="text-muted small mb-0">Append-only compliance log tracking user authentication, entity mutations, and administrative events</p>
    </div>
    <a asp-action="ExportCsv" 
       asp-route-user="@ViewBag.CurrentUser" 
       asp-route-module="@ViewBag.CurrentModule" 
       asp-route-action="@ViewBag.CurrentAction" 
       asp-route-fromDate="@ViewBag.FromDate" 
       asp-route-toDate="@ViewBag.ToDate" 
       class="btn btn-outline-success fw-semibold shadow-sm">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Audit Log (CSV)
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-2">
                <input type="text" name="user" value="@ViewBag.CurrentUser" class="form-control" placeholder="User / Email..." />
            </div>
            <div class="col-md-2">
                <select name="module" class="form-select">
                    <option value="">All Modules</option>
                    <option value="Authentication" selected="@(ViewBag.CurrentModule == "Authentication")">Authentication</option>
                    <option value="Customer" selected="@(ViewBag.CurrentModule == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewBag.CurrentModule == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewBag.CurrentModule == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewBag.CurrentModule == "FollowUp")">Follow-Up</option>
                    <option value="User Management" selected="@(ViewBag.CurrentModule == "User Management")">User Management</option>
                    <option value="Security" selected="@(ViewBag.CurrentModule == "Security")">Security</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(ViewBag.CurrentAction == "Login")">Login</option>
                    <option value="Logout" selected="@(ViewBag.CurrentAction == "Logout")">Logout</option>
                    <option value="Failed Login" selected="@(ViewBag.CurrentAction == "Failed Login")">Failed Login</option>
                    <option value="Create" selected="@(ViewBag.CurrentAction == "Create")">Create</option>
                    <option value="Update" selected="@(ViewBag.CurrentAction == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewBag.CurrentAction == "Delete")">Delete</option>
                    <option value="Convert Lead" selected="@(ViewBag.CurrentAction == "Convert Lead")">Convert Lead</option>
                    <option value="Role Change" selected="@(ViewBag.CurrentAction == "Role Change")">Role Change</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small fw-bold text-muted">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>IP Address</th>
                    <th>Details</th>
                    <th class="text-end">Changes</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="small font-monospace text-muted">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </td>
                            <td>
                                <span class="fw-semibold small"><i class="bi bi-person me-1 text-muted"></i>@item.UserName</span>
                            </td>
                            <td>
                                @{
                                    string actionColor = item.Action switch
                                    {
                                        "Login" => "bg-success-subtle text-success border border-success-subtle",
                                        "Logout" => "bg-secondary-subtle text-secondary border",
                                        "Failed Login" => "bg-danger text-white",
                                        "Create" => "bg-primary-subtle text-primary border border-primary-subtle",
                                        "Update" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                        "Delete" => "bg-danger-subtle text-danger border border-danger-subtle",
                                        "Convert Lead" => "bg-info-subtle text-info border border-info-subtle",
                                        _ => "bg-light text-dark border"
                                    };
                                }
                                <span class="badge @actionColor px-2 py-1">@item.Action</span>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@item.EntityName</span></td>
                            <td><span class="small font-monospace text-muted">@(item.RecordId ?? "—")</span></td>
                            <td>
                                @if (item.Result == "Success")
                                {
                                    <span class="badge bg-success text-white small"><i class="bi bi-check me-1"></i>Success</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white small"><i class="bi bi-x me-1"></i>@item.Result</span>
                                }
                            </td>
                            <td><span class="small font-monospace text-muted">@item.IpAddress</span></td>
                            <td>
                                <span class="small text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Details</span>
                            </td>
                            <td class="text-end">
                                @if (!string.IsNullOrEmpty(item.OldValue) || !string.IsNullOrEmpty(item.NewValue))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#diffModal-@item.AuditLogId">
                                        <i class="bi bi-file-diff me-1"></i> Diff
                                    </button>

                                    <!-- Diff Modal -->
                                    <div class="modal fade" id="diffModal-@item.AuditLogId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header">
                                                    <h5 class="modal-title"><i class="bi bi-code-slash me-2 text-primary"></i>Audit Snapshot #@item.AuditLogId — @item.Action on @item.EntityName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <div class="fw-semibold text-danger small text-uppercase mb-1"><i class="bi bi-dash-circle me-1"></i> Previous State (Old)</div>
                                                            <pre class="bg-light p-3 rounded-2 border small" style="max-height: 250px; overflow-y: auto;"><code>@(string.IsNullOrEmpty(item.OldValue) ? "None (New Creation)" : item.OldValue)</code></pre>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="fw-semibold text-success small text-uppercase mb-1"><i class="bi bi-plus-circle me-1"></i> Mutated State (New)</div>
                                                            <pre class="bg-light p-3 rounded-2 border small" style="max-height: 250px; overflow-y: auto;"><code>@(string.IsNullOrEmpty(item.NewValue) ? "None (Deleted)" : item.NewValue)</code></pre>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No audit log events match the query filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
