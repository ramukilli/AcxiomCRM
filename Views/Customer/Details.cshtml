@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer Details — {Model.CustomerName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <div>
            <h3 class="fw-bold mb-0">@Model.CustomerName</h3>
            <span class="badge bg-light text-dark border font-monospace me-2">@Model.CustomerCode</span>
            @if (Model.Status == "Active")
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Opportunity
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar2-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Customer Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-semibold mb-0 text-primary"><i class="bi bi-person-badge me-2"></i>Account Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Company Name:</span>
                        <span class="fw-semibold">@(Model.CompanyName ?? "Individual")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">@Model.Email</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold font-monospace">@Model.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">City / State:</span>
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.City) ? "—" : $"{Model.City}, {Model.State}")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Address:</span>
                        <span class="fw-semibold text-end">@(Model.Address ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Account Owner:</span>
                        <span class="fw-semibold">@(Model.Owner?.FullName ?? Model.Owner?.UserName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Registered Since:</span>
                        <span class="fw-semibold">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer History & Related Records -->
    <div class="col-lg-8">
        <!-- Related Opportunities -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0 text-success"><i class="bi bi-graph-up-arrow me-2"></i>Opportunities (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm py-0">
                    <i class="bi bi-plus"></i> Add
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Opportunity</th>
                                <th>Stage</th>
                                <th>Amount</th>
                                <th>Probability</th>
                                <th>Close Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Opportunities.Any())
                            {
                                foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                                @opp.OpportunityName
                                            </a>
                                        </td>
                                        <td><span class="badge bg-info-subtle text-info border">@opp.Stage</span></td>
                                        <td class="fw-bold font-monospace">$@opp.Amount.ToString("N2")</td>
                                        <td>@opp.Probability%</td>
                                        <td>@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">No opportunities logged for this customer.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0 text-info"><i class="bi bi-calendar2-check me-2"></i>Follow-Up Schedule (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm py-0">
                    <i class="bi bi-plus"></i> Schedule
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FollowUps.Any())
                            {
                                foreach (var fu in Model.FollowUps.OrderBy(f => f.FollowUpDate))
                                {
                                    <tr>
                                        <td class="font-monospace">@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@fu.FollowUpType</span></td>
                                        <td class="fw-semibold">@fu.Subject</td>
                                        <td>
                                            @if (fu.Status == "Completed")
                                            {
                                                <span class="badge bg-success-subtle text-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning">@fu.Status</span>
                                            }
                                        </td>
                                        <td class="text-muted">@(fu.Remarks ?? "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">No follow-ups scheduled.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
