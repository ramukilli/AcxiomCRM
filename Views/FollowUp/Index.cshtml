@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Engagements";
    var now = DateTime.UtcNow;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar2-check-fill text-info me-2"></i>Follow-Ups</h2>
        <p class="text-muted small mb-0">Schedule client touchpoints, track pending reminders, and handle rescheduling</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-calendar2-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Follow-Up Status Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 border-start border-4 border-info">
            <span class="text-muted small fw-semibold text-uppercase">Upcoming / Scheduled</span>
            <div class="fs-4 fw-bold font-monospace text-info mt-1">@ViewBag.UpcomingCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 border-start border-4 border-danger">
            <span class="text-muted small fw-semibold text-uppercase">Overdue Touchpoints</span>
            <div class="fs-4 fw-bold font-monospace text-danger mt-1">@ViewBag.OverdueCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 border-start border-4 border-success">
            <span class="text-muted small fw-semibold text-uppercase">Completed Activities</span>
            <div class="fs-4 fw-bold font-monospace text-success mt-1">@Model.Count(f => f.Status == "Completed")</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.CurrentStatus == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.CurrentStatus == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="type" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(ViewBag.CurrentType == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.CurrentType == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.CurrentType == "Email")">Email</option>
                    <option value="Demo" selected="@(ViewBag.CurrentType == "Demo")">Demo</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small fw-bold text-muted">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isOverdue = item.Status == "Planned" && item.FollowUpDate < now;
                        <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                            <td>
                                <span class="fw-semibold font-monospace @(isOverdue ? "text-danger" : "")">
                                    <i class="bi bi-clock me-1"></i>@item.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">OVERDUE</span>
                                }
                            </td>
                            <td>
                                @{
                                    string typeIcon = item.FollowUpType switch
                                    {
                                        "Call" => "bi-telephone-fill text-success",
                                        "Meeting" => "bi-people-fill text-primary",
                                        "Email" => "bi-envelope-fill text-info",
                                        _ => "bi-display-fill text-warning"
                                    };
                                }
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @typeIcon me-1"></i>@item.FollowUpType
                                </span>
                            </td>
                            <td class="fw-semibold">@item.Subject</td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none small text-dark fw-medium">
                                        <i class="bi bi-building me-1 text-muted"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none small text-dark fw-medium">
                                        <i class="bi bi-funnel me-1 text-muted"></i>@item.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border">Completed</span>
                                }
                                else if (item.Status == "Planned")
                                {
                                    <span class="badge bg-primary-subtle text-primary border">Planned</span>
                                }
                                else if (item.Status == "Missed")
                                {
                                    <span class="badge bg-danger-subtle text-danger border">Missed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Cancelled</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")</span>
                            </td>
                            <td>
                                <span class="small text-muted text-truncate d-inline-block" style="max-width: 150px;">@(item.Remarks ?? "—")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <!-- Complete Form -->
                                        <form asp-action="UpdateStatus" asp-route-id="@item.FollowUpId" asp-route-status="Completed" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>

                                        <!-- Reschedule Modal Trigger -->
                                        <button type="button" class="btn btn-outline-warning" title="Reschedule" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@item.FollowUpId">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }

                                    <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow up?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade" id="rescheduleModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h5 class="modal-title"><i class="bi bi-clock-history me-2 text-warning"></i>Reschedule Follow-Up</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="Reschedule" asp-route-id="@item.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-muted text-uppercase">New Scheduled Date & Time *</label>
                                                        <input type="datetime-local" name="newDate" class="form-control" required min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddT10:00")" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-muted text-uppercase">Reason / Remarks</label>
                                                        <textarea name="remarks" class="form-control" rows="2" placeholder="Reason for rescheduling..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning text-dark fw-semibold">Save New Schedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No follow-up touchpoints match the filter.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
