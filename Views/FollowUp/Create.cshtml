@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <h3 class="fw-bold mb-0">Schedule Client Follow-Up</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold text-info"><i class="bi bi-calendar2-plus me-2"></i>Follow-Up Details</h6>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Create" method="post" id="followUpForm">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold text-muted text-uppercase">Link to Customer Account</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.CustomersList" class="form-select">
                                <option value="">None / Not linked to customer</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold text-muted text-uppercase">Or Link to Sales Lead</label>
                            <select asp-for="LeadId" asp-items="ViewBag.LeadsList" class="form-select">
                                <option value="">None / Not linked to lead</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold text-muted text-uppercase">Scheduled Date & Time *</label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddT10:00")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                            <div class="form-text small">Cannot be earlier than today</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold text-muted text-uppercase">Touchpoint Type *</label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Demo">Demo</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label small fw-semibold text-muted text-uppercase">Subject / Objective *</label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss revised proposal & SLA terms" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-muted text-uppercase">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-muted text-uppercase">Assigned Staff</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold text-muted text-uppercase">Preparation Notes & Agenda</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Key talking points, deliverables..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" id="saveFollowUpBtn" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-calendar2-check me-1"></i> Confirm Schedule
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
