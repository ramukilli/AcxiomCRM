@{
    ViewData["Title"] = "Sign in with Google — AcxiomCRM";
    Layout = "_LayoutAuth";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Google Header -->
            <div class="card-header bg-white p-4 text-center border-bottom">
                <svg width="40" height="40" viewBox="0 0 48 48" class="mb-2">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <h4 class="fw-bold mb-1">Sign in with Google</h4>
                <p class="text-muted small mb-0">Choose an account to continue to <strong>AcxiomCRM Enterprise</strong></p>
            </div>

            <div class="card-body p-4 p-md-4 bg-white">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- One-click Quick Google Accounts -->
                <div class="mb-3">
                    <span class="small text-muted fw-bold text-uppercase d-block mb-2">Select Google Account:</span>
                    <div class="list-group list-group-flush border rounded-3 mb-3">
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center py-3" onclick="fillGoogle('alex.turner@gmail.com', 'Alex Turner')">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                AT
                            </div>
                            <div class="text-start">
                                <div class="fw-bold text-dark">Alex Turner</div>
                                <div class="text-muted small font-monospace">alex.turner@gmail.com</div>
                            </div>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </button>

                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center py-3" onclick="fillGoogle('sarah.connor@gmail.com', 'Sarah Connor')">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                SC
                            </div>
                            <div class="text-start">
                                <div class="fw-bold text-dark">Sarah Connor</div>
                                <div class="text-muted small font-monospace">sarah.connor@gmail.com</div>
                            </div>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </button>
                    </div>
                </div>

                <!-- Or Enter Custom Google Account Form -->
                <form asp-action="GoogleDemoLogin" method="post" id="googleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase">Or Use Another Google Account</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-google text-danger"></i></span>
                            <input type="email" name="email" id="googleEmail" class="form-control border-start-0" placeholder="your.name@gmail.com" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase">Google Display Name</label>
                        <input type="text" name="fullName" id="googleName" class="form-control" placeholder="Your Full Name" />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-shield-check me-2"></i> Authorize & Enter AcxiomCRM
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-action="Login" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Cancel & Return to Login
                        </a>
                    </div>
                </form>

                <!-- Production Google Cloud Setup Note -->
                <div class="mt-4 p-3 bg-light rounded-3 border small text-muted">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle-fill text-primary me-1"></i> Production Google Cloud OAuth:</div>
                    To connect to a live Google Cloud project, enter your <code>ClientId</code> and <code>ClientSecret</code> inside <code>appsettings.json</code> under <code>Authentication:Google</code>. The app will automatically switch to live Google OAuth consent screens!
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillGoogle(email, name) {
            document.getElementById('googleEmail').value = email;
            document.getElementById('googleName').value = name;
            document.getElementById('googleForm').submit();
        }
    </script>
}
