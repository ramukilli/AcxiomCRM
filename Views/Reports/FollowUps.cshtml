@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Ups Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Reports</a>
        <div>
            <h3 class="fw-bold mb-0">Follow-Up Engagement Report</h3>
            <span class="text-muted small">Total: @Model.Count() touchpoints</span>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="FollowUps" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Demo" selected="@(ViewBag.Type == "Demo")">Demo</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="FollowUps" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-uppercase fw-bold text-muted">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Status</th>
                    <th>Assigned Rep</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="font-monospace">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                        <td class="fw-semibold">@f.Subject</td>
                        <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "—")</td>
                        <td><span class="badge bg-secondary-subtle text-secondary border">@f.Status</span></td>
                        <td>@(f.AssignedUser?.FullName ?? f.AssignedUser?.UserName ?? "Unassigned")</td>
                        <td class="text-muted">@(f.Remarks ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
