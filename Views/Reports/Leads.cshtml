@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Reports</a>
        <div>
            <h3 class="fw-bold mb-0">Lead Generation Report</h3>
            <span class="text-muted small">Total: @Model.Count() leads</span>
        </div>
    </div>
    <a asp-action="ExportCsv" asp-route-type="leads" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" class="btn btn-outline-success fw-semibold">
        <i class="bi bi-download me-1"></i> Export to CSV
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Leads" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.Status == "Qualified")">Qualified</option>
                    <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="source" class="form-select">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(ViewBag.Source == "Website")">Website</option>
                    <option value="Referral" selected="@(ViewBag.Source == "Referral")">Referral</option>
                    <option value="Cold Call" selected="@(ViewBag.Source == "Cold Call")">Cold Call</option>
                    <option value="Partner" selected="@(ViewBag.Source == "Partner")">Partner</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Leads" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-uppercase fw-bold text-muted">
                <tr>
                    <th>Code</th>
                    <th>Prospect Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned Rep</th>
                    <th>Conversion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="font-monospace">@l.LeadCode</td>
                        <td class="fw-semibold">@l.LeadName</td>
                        <td>@(l.CompanyName ?? "—")</td>
                        <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                        <td><span class="badge bg-primary-subtle text-primary border">@l.Status</span></td>
                        <td><span class="badge bg-secondary">@l.Priority</span></td>
                        <td class="font-monospace fw-bold text-success">$@l.ExpectedValue.ToString("N2")</td>
                        <td>@(l.AssignedUser?.FullName ?? l.AssignedUser?.UserName ?? "Unassigned")</td>
                        <td>
                            @if (l.Status == "Converted")
                            {
                                <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Converted</span>
                            }
                            else
                            {
                                <span class="text-muted">Open</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
