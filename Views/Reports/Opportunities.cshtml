@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Reports</a>
        <div>
            <h3 class="fw-bold mb-0">Opportunities & Pipeline Report</h3>
            <span class="text-muted small">Total: @Model.Count() deals | Sum: $@Model.Sum(o => o.Amount).ToString("N0")</span>
        </div>
    </div>
    <a asp-action="ExportCsv" asp-route-type="opportunities" asp-route-stage="@ViewBag.Stage" class="btn btn-outline-success fw-semibold">
        <i class="bi bi-download me-1"></i> Export to CSV
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Opportunities" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Opportunities" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-uppercase fw-bold text-muted">
                <tr>
                    <th>ID</th>
                    <th>Opportunity Name</th>
                    <th>Customer Account</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Amount ($)</th>
                    <th>Weighted Value ($)</th>
                    <th>Close Date</th>
                    <th>Deal Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="font-monospace">#@o.OpportunityId</td>
                        <td class="fw-semibold">@o.OpportunityName</td>
                        <td>@(o.Customer?.CustomerName ?? "—")</td>
                        <td><span class="badge @(o.Stage == "Won" ? "bg-success" : (o.Stage == "Lost" ? "bg-danger" : "bg-primary-subtle text-primary border"))">@o.Stage</span></td>
                        <td>@o.Probability%</td>
                        <td class="font-monospace fw-bold">$@o.Amount.ToString("N2")</td>
                        <td class="font-monospace fw-bold text-success">$@o.WeightedAmount.ToString("N2")</td>
                        <td class="font-monospace text-muted">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                        <td>@(o.AssignedUser?.FullName ?? o.AssignedUser?.UserName ?? "Unassigned")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
