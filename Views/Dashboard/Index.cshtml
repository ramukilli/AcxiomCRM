@model AcxiomCRM.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Executive Dashboard";
    var role = ViewBag.UserRole as string ?? "SalesExecutive";
}

<!-- Welcome & Scope Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            Welcome back, @ViewBag.UserName! 
            <span class="badge @(role == "Admin" ? "bg-danger" : (role == "Manager" ? "bg-primary" : "bg-success")) fs-6 align-middle ms-2">
                @role View
            </span>
        </h2>
        <p class="text-muted small mb-0">
            @if (role == "Admin")
            {
                <span>Enterprise Scope: Viewing organization-wide CRM metrics, security audits, and users.</span>
            }
            else if (role == "Manager")
            {
                <span>Management Scope: Monitoring team pipeline health, conversion velocity, and performance.</span>
            }
            else
            {
                <span>Representative Scope: Tracking your assigned accounts, open leads, and upcoming touchpoints.</span>
            }
        </p>
    </div>

    <!-- Date Filter Buttons -->
    <div class="btn-group shadow-sm bg-white rounded-3 p-1 border" role="group">
        <a asp-action="Index" asp-route-dateFilter="AllTime" class="btn btn-sm @(ViewBag.DateFilter == "AllTime" ? "btn-primary" : "btn-light text-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(ViewBag.DateFilter == "Today" ? "btn-primary" : "btn-light text-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(ViewBag.DateFilter == "ThisWeek" ? "btn-primary" : "btn-light text-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(ViewBag.DateFilter == "ThisMonth" ? "btn-primary" : "btn-light text-secondary")">This Month</a>
    </div>
</div>

<!-- Overdue Alert Ribbon if applicable -->
@if (Model.OverdueFollowUpsCount > 0)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong>Attention Required:</strong> You have <strong>@Model.OverdueFollowUpsCount overdue touchpoint(s)</strong> awaiting completion or rescheduling.
            </div>
        </div>
        <a asp-controller="FollowUp" asp-action="Index" asp-route-status="Planned" class="btn btn-sm btn-danger px-3">
            Review Touchpoints
        </a>
    </div>
}

<!-- Mandatory Dashboard KPI Cards (Section 17.11) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold mb-0 mt-1 font-monospace text-dark">@Model.TotalCustomers</h3>
                    <div class="small text-muted mt-2">Active business accounts</div>
                </div>
                <div class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Total Leads & Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Leads (Total / Open)</span>
                    <h3 class="fw-bold mb-0 mt-1 font-monospace text-dark">
                        @Model.TotalLeads <span class="fs-6 text-muted font-monospace">(@Model.OpenLeads Open)</span>
                    </h3>
                    <div class="small text-muted mt-2">Prospect qualification pool</div>
                </div>
                <div class="bg-warning-subtle text-warning-emphasis p-2 rounded-3">
                    <i class="bi bi-funnel-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Opportunities (Total / Open / Won / Lost) -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Deals (Total / Open)</span>
                    <h3 class="fw-bold mb-0 mt-1 font-monospace text-dark">
                        @Model.TotalOpportunities <span class="fs-6 text-muted font-monospace">(@Model.OpenOpportunities Open)</span>
                    </h3>
                    <div class="small text-success mt-2">
                        <i class="bi bi-trophy-fill me-1"></i><strong>@Model.WonOpportunities Won</strong> &bull; <span class="text-danger">@Model.LostOpportunities Lost</span>
                    </div>
                </div>
                <div class="bg-success-subtle text-success p-2 rounded-3">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Total & Weighted Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pipeline Value</span>
                    <h3 class="fw-bold mb-0 mt-1 font-monospace text-primary">
                        $@Model.TotalPipelineValue.ToString("N0")
                    </h3>
                    <div class="small text-muted mt-2">
                        Weighted: <strong class="text-info font-monospace">$@Model.WeightedPipelineValue.ToString("N0")</strong>
                    </div>
                </div>
                <div class="bg-info-subtle text-info p-2 rounded-3">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mandatory Chart.js Visualizations (Section 17.12) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Opportunity Pipeline by Stage -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0 text-dark">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Opportunity Pipeline by Stage ($)
                </h6>
                <span class="badge bg-light text-muted border">Active Deals</span>
            </div>
            <div class="card-body p-4">
                <div style="height: 290px;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Lead Status Distribution -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-warning me-2"></i>Lead Status Breakdown
                </h6>
                <span class="badge bg-light text-muted border">Prospects</span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                <div style="height: 270px; width: 100%;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart 3 & Recent Operations Feed -->
<div class="row g-4 mb-4">
    <!-- Monthly Won Revenue Trend -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-semibold mb-0 text-dark">
                    <i class="bi bi-graph-up text-success me-2"></i>Monthly Sales & Closed Deals Performance
                </h6>
            </div>
            <div class="card-body p-4">
                <div style="height: 260px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming & Scheduled Follow-Ups Feed -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0 text-dark">
                    <i class="bi bi-calendar2-week-fill text-info me-2"></i>Upcoming Touchpoints
                </h6>
                <a asp-controller="FollowUp" asp-action="Index" class="small text-decoration-none fw-semibold">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush small">
                    @if (Model.UpcomingFollowUps.Any())
                    {
                        foreach (var fu in Model.UpcomingFollowUps)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-semibold text-dark">@fu.Subject</div>
                                    <div class="text-muted font-monospace" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock me-1"></i>@fu.FollowUpDate.ToString("MMM dd, yyyy HH:mm") &bull; @fu.FollowUpType
                                    </div>
                                </div>
                                <form asp-controller="FollowUp" asp-action="UpdateStatus" asp-route-id="@fu.FollowUpId" asp-route-status="Completed" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="Mark Done">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-calendar-check fs-3 d-block mb-1 text-secondary"></i>
                            No upcoming follow-ups scheduled.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Opportunity Pipeline Stage Chart (Bar Chart)
            const stageCtx = document.getElementById('pipelineStageChart')?.getContext('2d');
            if (stageCtx) {
                new Chart(stageCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageLabels)),
                        datasets: [{
                            label: 'Pipeline Amount ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageAmounts)),
                            backgroundColor: [
                                'rgba(59, 130, 246, 0.75)',
                                'rgba(14, 165, 233, 0.75)',
                                'rgba(245, 158, 11, 0.75)',
                                'rgba(16, 185, 129, 0.75)',
                                'rgba(239, 68, 68, 0.75)'
                            ],
                            borderColor: [
                                '#2563eb',
                                '#0284c7',
                                '#d97706',
                                '#059669',
                                '#dc2626'
                            ],
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '$' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Lead Status Breakdown Chart (Doughnut Chart)
            const leadCtx = document.getElementById('leadStatusChart')?.getContext('2d');
            if (leadCtx) {
                new Chart(leadCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                            backgroundColor: [
                                '#3b82f6', // New
                                '#0ea5e9', // Contacted
                                '#f59e0b', // Qualified
                                '#10b981', // Converted
                                '#ef4444'  // Lost
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            }
                        }
                    }
                });
            }

            // 3. Monthly Sales Chart (Line / Area Chart)
            const salesCtx = document.getElementById('monthlySalesChart')?.getContext('2d');
            if (salesCtx) {
                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                        datasets: [{
                            label: 'Won Revenue ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesValues)),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 3,
                            pointBackgroundColor: '#10b981',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '$' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
