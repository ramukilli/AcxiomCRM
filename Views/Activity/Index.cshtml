@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-secondary me-2"></i>Activities</h2>
        <p class="text-muted small mb-0">Unified communications and sales tasks: Calls, Meetings, Emails, and Tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Log Activity
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="type" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(ViewBag.CurrentType == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.CurrentType == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.CurrentType == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.CurrentType == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Completed</option>
                    <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Pending</option>
                    <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small fw-bold text-muted">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Status</th>
                    <th>Staff / Rep</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="small font-monospace text-muted">@item.ActivityDate.ToString("yyyy-MM-dd HH:mm")</span>
                            </td>
                            <td>
                                @{
                                    string icon = item.ActivityType switch
                                    {
                                        "Call" => "bi-telephone-fill text-success",
                                        "Meeting" => "bi-people-fill text-primary",
                                        "Email" => "bi-envelope-fill text-info",
                                        _ => "bi-check2-square text-warning"
                                    };
                                }
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @icon me-1"></i>@item.ActivityType
                                </span>
                            </td>
                            <td class="fw-semibold">@item.Subject</td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none small text-dark fw-medium">
                                        <i class="bi bi-building me-1 text-muted"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none small text-dark fw-medium">
                                        <i class="bi bi-funnel me-1 text-muted"></i>@item.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border">@item.Status</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")</span>
                            </td>
                            <td>
                                <span class="small text-muted text-truncate d-inline-block" style="max-width: 250px;">@(item.Description ?? "—")</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No activity records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
