@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"Deal Details — {Model.OpportunityName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <div>
            <h3 class="fw-bold mb-0">@Model.OpportunityName</h3>
            <span class="badge bg-light text-dark border me-2">Deal #@Model.OpportunityId</span>
            <span class="badge bg-success-subtle text-success border">@Model.Stage</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this opportunity?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </form>
        }
    </div>
</div>

<!-- Stage Progression Pipeline Strip -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small text-muted fw-bold text-uppercase">Sales Pipeline Progress</span>
            <span class="small fw-semibold">Current Stage: <strong class="text-primary">@Model.Stage</strong></span>
        </div>
        <div class="btn-group w-100" role="group">
            @foreach (var stg in new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" })
            {
                var isCurrent = Model.Stage == stg;
                var btnStyle = isCurrent ? "btn-primary" : "btn-outline-secondary";
                <form asp-action="SetStage" asp-route-id="@Model.OpportunityId" asp-route-newStage="@stg" method="post" class="flex-fill">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @btnStyle w-100 py-2 small fw-semibold">
                        @if (isCurrent) { <i class="bi bi-check2-circle me-1"></i> }
                        @stg
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white text-center">
            <span class="text-muted small fw-semibold text-uppercase">Gross Deal Amount</span>
            <div class="fs-2 fw-bold font-monospace text-dark mt-2">$@Model.Amount.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white text-center">
            <span class="text-muted small fw-semibold text-uppercase">Probability Rating</span>
            <div class="fs-2 fw-bold font-monospace text-info mt-2">@Model.Probability%</div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-info" style="width: @Model.Probability%;"></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white text-center">
            <span class="text-muted small fw-semibold text-uppercase">Weighted Expected Value</span>
            <div class="fs-2 fw-bold font-monospace text-success mt-2">$@Model.WeightedAmount.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-semibold mb-0 text-primary"><i class="bi bi-info-circle me-2"></i>Account & Deal Scope</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Customer Account:</span>
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-semibold text-decoration-none">
                                @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                            </a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Expected Close Date:</span>
                        <span class="fw-bold font-monospace">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Assigned Deal Owner:</span>
                        <span class="fw-semibold">@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.UserName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Deal Created Date:</span>
                        <span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-semibold mb-0 text-secondary"><i class="bi bi-file-text me-2"></i>Notes & Details</h6>
            </div>
            <div class="card-body">
                <p class="small text-secondary mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded for this opportunity." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>
