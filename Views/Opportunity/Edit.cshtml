@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"Edit Deal — {Model.OpportunityName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <h3 class="fw-bold mb-0">Edit Opportunity: @Model.OpportunityName</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold text-success"><i class="bi bi-pencil-square me-2"></i>Update Opportunity Details</h6>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="LeadId" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold text-muted text-uppercase">Opportunity Name *</label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label small fw-semibold text-muted text-uppercase">Customer Account *</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.CustomersList" class="form-select"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label small fw-semibold text-muted text-uppercase">Amount ($) *</label>
                            <input asp-for="Amount" id="oppAmount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label small fw-semibold text-muted text-uppercase">Probability (%) *</label>
                            <input asp-for="Probability" id="oppProb" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted text-uppercase">Weighted Value</label>
                            <input type="text" id="weightedValueDisplay" class="form-control bg-light font-monospace fw-bold text-success" readonly value="@Model.WeightedAmount" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label small fw-semibold text-muted text-uppercase">Pipeline Stage *</label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold text-muted text-uppercase">Expected Close Date *</label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-muted text-uppercase">Assigned Rep</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold text-muted text-uppercase">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function recalculateWeighted() {
            var amt = parseFloat(document.getElementById('oppAmount').value) || 0;
            var prob = parseFloat(document.getElementById('oppProb').value) || 0;
            var weighted = (amt * prob / 100).toFixed(2);
            document.getElementById('weightedValueDisplay').value = weighted;
        }

        document.getElementById('oppAmount')?.addEventListener('input', recalculateWeighted);
        document.getElementById('oppProb')?.addEventListener('input', recalculateWeighted);
    </script>
}
